# Copy this file to .env and replace all REPLACE_* values.
# Never commit .env or paste its contents into chat.

TG_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
APP_ID=REPLACE_WITH_TELEGRAM_APP_ID
API_HASH=REPLACE_WITH_TELEGRAM_API_HASH
OWNER_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# The private Telegram channel used as the bot's file database.
CHANNEL_ID=REPLACE_WITH_DATABASE_CHANNEL_ID
DATABASE_URL=mongodb+srv://REPLACE_WITH_MONGODB_USER:REPLACE_WITH_MONGODB_PASSWORD@REPLACE_WITH_MONGODB_HOST/teledrop
DATABASE_NAME=teledrop

# Force-sub channels; use 0 to disable an unused slot.
FORCE_SUB_CHANNEL1=0
FORCE_SUB_CHANNEL2=0
FORCE_SUB_CHANNEL3=0
FORCE_SUB_CHANNEL4=0

# Link lifetime and delivered-file deletion delay, in seconds.
LINK_TTL=86400
TIME=86400
PROTECT_CONTENT=True

# Optional tuning.
PORT=8080
CLEANUP_INTERVAL=60
CLEANUP_MAX_ATTEMPTS=5
CLEANUP_RETRY_BASE_SECONDS=60
CLEANUP_RETRY_MAX_SECONDS=3600
MAX_BATCH_MESSAGES=100
TG_BOT_WORKERS=4
TELEGRAM_API_TIMEOUT=30
ADMINS=

# Optional central control-plane agent. Leave CONTROL_PLANE_URL empty to disable.
APP_VERSION=2.2.0-dev
CONTROL_PLANE_URL=
CONTROL_PLANE_INSTANCE_ID=
CONTROL_PLANE_SECRET=
CONTROL_PLANE_HEARTBEAT_INTERVAL=60
CONTROL_PLANE_TIMEOUT=10

PICS=
START_MESSAGE=
FORCE_SUB_MESSAGE="👋 Hello {first} {last}\n\nKamu harus bergabung di Channel/Grup kami terlebih dahulu untuk melihat File/Link yang kami bagikan\n\nSilakan join ke Channel & Group terlebih dahulu kemudian klik tombol muat ulang dibawah untuk melanjutkan"
CUSTOM_CAPTION=
DISABLE_CHANNEL_BUTTON=False
ALLOW_LEGACY_LINKS=False
MAIN_CHANNEL_URL=
SOURCE_CODE_URL=
BOT_STATS_TEXT=
USER_REPLY_TEXT=