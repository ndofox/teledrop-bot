APP_ID=18199405
API_HASH=REPLACE_WITH_TELEGRAM_API_HASH
OWNER_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# The private Telegram channel used as the bot's file database.
CHANNEL_ID=-1003494339426
DATABASE_URL=mongodb+srv://REPLACE_WITH_MONGODB_USER:REPLACE_WITH_MONGODB_PASSWORD@REPLACE_WITH_MONGODB_HOST/?appName=Cluster0
DATABASE_NAME=filesharexbot

# Force-sub channels; use 0 to disable an unused slot.
FORCE_SUB_CHANNEL1=-1001931658250
FORCE_SUB_CHANNEL2=-1001976211484
FORCE_SUB_CHANNEL3=-1001399247743
FORCE_SUB_CHANNEL4=0

# Link lifetime and delivered-file deletion delay, in seconds.
LINK_TTL=86400
TIME=86400
PROTECT_CONTENT=True

# Optional tuning.
PORT=8080
CLEANUP_INTERVAL=60
MAX_BATCH_MESSAGES=100
TG_BOT_WORKERS=4
TELEGRAM_API_TIMEOUT=30
ADMINS=
PICS=
START_MESSAGE=
