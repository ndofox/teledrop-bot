# Server-only configuration. Never commit a real .env file or secrets.
CONTROL_PLANE_DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/teledrop_control
CONTROL_PLANE_DATABASE_NAME=teledrop_control
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_MAX_CLOCK_SKEW=300
CONTROL_PLANE_NONCE_TTL=600
CONTROL_PLANE_METRICS_DAILY_MAX=30
CONTROL_PLANE_REQUEST_MAX_BODY_BYTES=65536
CONTROL_PLANE_METRICS_PROCESSING_LEASE_SECONDS=300
CONTROL_PLANE_METRICS_BATCH_RETENTION_DAYS=30
CONTROL_PLANE_METRICS_CLEANUP_LIMIT=100

# JSON mapping of provisioned instance IDs to unique secrets.
# Use a secret manager in production instead of storing this in a local file.
CONTROL_PLANE_AGENT_SECRETS_JSON={"bot-01":"REPLACE_WITH_16_PLUS_CHAR_SECRET"}